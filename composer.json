{
    "name": "weldist/laravel-passport-client-scopes",
    "description": "Per-client default scopes and RFC 6750 insufficient_scope responses for Laravel Passport client credentials tokens.",
    "keywords": ["laravel", "passport", "oauth2", "client-credentials", "scopes", "insufficient-scope"],
    "license": "MIT",
    "authors": [
        {
            "name": "X-Adam",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://mehmetogmen.com.tr"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/passport": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Weldist\\Laravel\\Passport\\ClientScopes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weldist\\Laravel\\Passport\\ClientScopes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weldist\\Laravel\\Passport\\ClientScopes\\PassportClientScopesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
